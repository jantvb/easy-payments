# Demo backend secrets — never commit a real .env with credentials.
#
# Copy to server/.env and fill in TEST / Sandbox values only.

# Stripe TEST MODE only (sk_test_...). Angular uses pk_test_... only.
# Klarna (Easy Payments) also uses this Stripe secret — enable Klarna in the Stripe Dashboard (TEST).
# No separate Klarna API username/password is required for the Stripe-backed Klarna flow.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PayPal Sandbox REST credentials from https://developer.paypal.com/dashboard/
# Angular receives PAYPAL Client ID only (never the secret).
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
# sandbox (default) | live — keep sandbox for local demos
PAYPAL_MODE=sandbox

PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
