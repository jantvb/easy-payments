# Demo backend secrets — never commit a real .env with credentials.
#
# Copy to server/.env and fill in TEST / Sandbox values only.

# Stripe TEST MODE only. Angular uses YOUR_STRIPE_PUBLISHABLE_KEY (pk_test_...).
# Klarna / Affirm (Easy Payments) also use this Stripe secret — enable them in the Stripe Dashboard (TEST).
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY

# Optional. Stripe webhook signing secret (whsec_...) for POST /api/webhooks/stripe.
# Server-only. Never put this in Angular. Omit to leave Stripe webhooks unavailable (safe 503).
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# PayPal Sandbox REST credentials from https://developer.paypal.com/dashboard/
# Angular receives YOUR_PAYPAL_CLIENT_ID only (never the secret).
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
# sandbox (default) | live — keep sandbox for local demos
PAYPAL_MODE=sandbox

# Optional. PayPal webhook id for POST /api/webhooks/paypal verification.
# Server-only. Never put this in Angular. Omit to leave PayPal webhooks unavailable (safe 503).
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID

PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
