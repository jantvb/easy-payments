{
  "name": "easy-payments",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build easy-payments && ng build demo",
    "build:lib": "ng build easy-payments",
    "build:demo": "ng build demo",
    "watch": "ng build easy-payments --watch --configuration development",
    "test": "ng test easy-payments --watch=false --browsers=ChromeHeadless",
    "test:demo": "ng test demo --watch=false --browsers=ChromeHeadless",
    "server:install": "npm --prefix server install",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server run start:dev",
    "server:test": "npm --prefix server test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@stripe/stripe-js": "^8.11.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "@types/jasmine": "~5.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.1.1",
    "typescript": "~6.0.3"
  }
}